[user]
	name = brijesh
	email = 145837789+brijesh-0@users.noreply.github.com
	signingkey = ~/.ssh/github_ssh.pub
[commit]
	gpgsign = true
	template = ~/.gitmessage
[tag]
	gpgSign = true
[core]
	editor = nvim
	pager = delta
	excludesfile = ~/.gitignore
[alias]
	co = switch
	br = branch -a
	cm = commit
	st = status
	last = log -1 HEAD
	unstage = reset HEAD --
	lg = log --oneline --graph --decorate --exclude='refs/t3/*' -n 40 --all
	amend = commit --amend --no-edit
	dc = diff --cached
	hist = log --graph --pretty=format:'%C(yellow)%h%C(reset) %C(green)%ad%C(reset) | %C(cyan)%s%C(reset) %C(red)%d%C(reset) [%C(magenta)%an%C(reset)]' --date=short
	undo = reset --soft HEAD~1
	branches = branch --sort=-committerdate
	conflicts = diff --name-only --diff-filter=U

[log]
	date = relative
[color]
	ui = auto
[status]
	short = true

[include]
	path = ~/.config/delta/theme-catppuccin.gitconfig

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
	side-by-side = false
	features = catppuccin-mocha
	line-numbers = true

[merge]
	conflictStyle = zdiff3	
[init]
	defaultBranch = main
[diff]
	tool = delta
[difftool "delta"]
	cmd = delta \"$LOCAL\" \"$REMOTE\"
[gpg]
	format = ssh
[push]
	autoSetupRemote = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[fetch]
	prune = true
[branch]
	sort = -committerdate
